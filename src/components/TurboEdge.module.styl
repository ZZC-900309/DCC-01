.turboEdge
  stroke-width: 2
  stroke: url(#edge-gradient)
  transition: all 0.2s ease
  filter: drop-shadow(0 0 8px rgba(42, 138, 246, 0.3))

  &:hover
    stroke-width: 3
    filter: drop-shadow(0 0 12px rgba(42, 138, 246, 0.5))

.edgeCircle
  fill: none
  stroke: #2a8af6
  stroke-opacity: 0.75
  r: 2
